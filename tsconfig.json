{
  "compilerOptions": {
    "module": "es6",
    "target": "es6",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "YSUI.createElement",
    "jsxFragmentFactory": "YSUI.createFragment",
    "experimentalDecorators": true,
    "declaration": true,
    "declarationDir": "./dist/types",
    "outDir": "./dist",
    "moduleResolution": "node",
    "lib": [
      "ES2017",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src"
  ]
}
